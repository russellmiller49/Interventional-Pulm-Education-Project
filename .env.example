# Public base URL for the application
NEXT_PUBLIC_SITE_URL=https://example.com

# Procedure Suite base URL (required for /ip-registry redirect)
PROC_API_URL=http://localhost:8000

# Supabase configuration shared by the main site and the embedded SoCal EBUS course build
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Server-side Supabase credentials (required for signed volume URLs)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated Literature database (Supabase project `IP_Literature`). Literature data lives in its
# own project; the main site's authentication and every other module keep the settings above and
# are unaffected by these values. The Literature client never falls back to the main project.
#
# All three are required together. The contract is STRICT BY DEFAULT: unless the explicit local
# mode below is set, the raw LITERATURE_SUPABASE_URL string is compared BYTE FOR BYTE against the
# single approved value `https://<approved-ref>.supabase.co/` (trailing slash included) before any
# URL parsing — no trimming, case folding, `:443`, `/./`, or percent-encoding variant is accepted
# — together with a ref matching LITERATURE_SUPABASE_EXPECTED_PROJECT_REF and a current-model
# `sb_secret_…` credential. A missing, partial, mismatched, loopback, non-canonical, or
# wrong-project configuration fails closed: the Literature module reports "not configured"
# rather than reading the wrong database.
#
# PRODUCTION VALUES ARE RESERVED FOR THE LATER CUTOVER. The production Literature runtime is not
# activated: setting these three variables in a deployed environment validates them and does
# nothing else — no Supabase client is constructed and no remote RPC becomes reachable, so the
# module still reports "not configured". Activation is a reviewed CODE change
# (LITERATURE_PRODUCTION_RUNTIME_ACTIVATION in src/features/literature/server/
# dedicated-project-contract.ts), made by the separate capability-gating / cutover package, never
# by an environment variable. Only the local values below do anything today.
LITERATURE_SUPABASE_URL=https://YOUR_LITERATURE_PROJECT_REF.supabase.co/
LITERATURE_SUPABASE_SECRET_KEY=
LITERATURE_SUPABASE_EXPECTED_PROJECT_REF=YOUR_LITERATURE_PROJECT_REF

# Server-only runtime mode. Closed enum; the ONLY value that relaxes anything is the exact string
# `local`, which permits only a canonical local-host target (localhost, 127.0.0.1, or [::1] —
# 0.0.0.0 is a wildcard bind address, not a destination, and is refused along with *.localhost
# and other near-local spellings) plus the legacy credential
# variable below. Absent, empty, `Local`, `production`, or any unrecognised value gets the strict
# hosted contract, so a deployed environment that forgets this variable fails safe rather than
# open. NODE_ENV is deliberately not consulted. `npm run literature:local:start` is the intended
# consumer for local development.
LITERATURE_SUPABASE_RUNTIME_MODE=

# Legacy alias for LITERATURE_SUPABASE_SECRET_KEY. Accepted only when
# LITERATURE_SUPABASE_RUNTIME_MODE=local, so the existing local workflow keeps working. The strict
# contract rejects it. Setting both this and LITERATURE_SUPABASE_SECRET_KEY to *different* values
# fails closed rather than picking one.
LITERATURE_SUPABASE_SERVICE_ROLE_KEY=

# Read only by the opt-in local integration test (LITERATURE_INTEGRATION_TEST=1). Not used by the
# application or by any operational script.
LITERATURE_SUPABASE_ANON_KEY=

# PCCM intro course media delivery.
# Default provider is S3. Set PCCM_INTRO_COURSE_MEDIA_PROVIDER=supabase only for the old
# Supabase Storage bucket workflow.
PCCM_INTRO_COURSE_MEDIA_PROVIDER=s3
PCCM_INTRO_COURSE_S3_BUCKET=pccmintro
PCCM_INTRO_COURSE_S3_REGION=us-east-1
PCCM_INTRO_COURSE_S3_BASE_URL=https://pccmintro.s3.us-east-1.amazonaws.com
PCCM_INTRO_COURSE_SIGNED_URL_TTL_SECONDS=1800

# Required when the S3 bucket is private. Leave blank only if S3 objects are public-readable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Supabase Edge Function email delivery for SoCal EBUS course notifications.
# Set these in Supabase Function Secrets for production.
RESEND_API_KEY=
SENDGRID_API_KEY=
SOCAL_EBUS_EMAIL_FROM="SoCal EBUS Course <no-reply@example.com>"
SOCAL_EBUS_EMAIL_REPLY_TO=
SOCAL_EBUS_COURSE_URL=https://interventionalpulm.org/socal-ebus-course

# GitHub personal access token used server-side for API requests
GITHUB_TOKEN=

# Analytics provider identifier (none | plausible | ga4)
ANALYTICS_PROVIDER=none

# IP Preference Card Builder. Development is enabled automatically; production
# remains disabled unless this value is explicitly true.
NEXT_PUBLIC_ENABLE_PREFERENCE_CARDS=false

# Server-side API key used only by local openFDA catalog-enrichment scripts.
# Never expose this through NEXT_PUBLIC_* or commit a real value.
OPENFDA_API_KEY=
OPENFDA_REQUESTS_PER_SECOND=3
OPENFDA_MAX_RETRIES=5
OPENFDA_TIMEOUT_MS=30000
OPENFDA_CACHE_DIR=local-data/ip-preference-cards/openfda/cache
OPENFDA_BULK_DIR=local-data/ip-preference-cards/openfda/bulk

# Local-only developer unlock for protected pages. Never enable this in production.
LOCAL_DEV_AUTH_ENABLED=0
LOCAL_DEV_AUTH_TOKEN=
