{
  "version": 1,
  "defaultBranch": "origin/main",
  "branchAgents": ["codex", "claude"],
  "maxProvisionedWorktrees": 5,
  "defaultSharedPaths": [
    "package.json",
    "package-lock.json",
    "jest.config.cjs",
    "src/data/training-modules.ts",
    "src/i18n/navigation.ts",
    "src/lib/module-assets.ts",
    "src/lib/non-public-modules*"
  ],
  "platformScope": {
    "id": "platform",
    "description": "Cross-cutting repository infrastructure. This is a scope, not a learner module.",
    "ownedPaths": [
      "AGENTS.md",
      "CLAUDE.md",
      ".github/workflows/worktree-scope.yml",
      ".husky/pre-commit",
      "config/worktrees/**",
      "docs/development/worktree-isolation.md",
      "scripts/worktrees/**"
    ],
    "sharedPaths": [
      ".gitignore",
      "package.json",
      "package-lock.json",
      "jest.config.cjs",
      "messages/*.json",
      "src/components/layout/**",
      "src/data/training-modules.ts",
      "src/i18n/navigation.ts",
      "src/lib/draft-modules*",
      "src/lib/module-assets.ts",
      "src/lib/non-public-modules*",
      "supabase/migrations/**",
      "supabase/seed/**"
    ],
    "externalInputProfile": "environment"
  },
  "protectedSharedPaths": [
    { "pattern": ".gitignore", "lease": ".gitignore" },
    { "pattern": "package.json", "lease": "package.json" },
    { "pattern": "package-lock.json", "lease": "package-lock.json" },
    { "pattern": "jest.config.cjs", "lease": "jest.config.cjs" },
    { "pattern": "messages/*.json", "lease": "translations" },
    { "pattern": "src/components/layout/**", "lease": "shared-navigation" },
    { "pattern": "src/i18n/navigation.ts", "lease": "shared-navigation" },
    { "pattern": "src/data/training-modules.ts", "lease": "shared-module-catalog" },
    { "pattern": "src/lib/draft-modules*", "lease": "shared-module-catalog" },
    { "pattern": "src/lib/module-assets.ts", "lease": "shared-module-catalog" },
    { "pattern": "src/lib/non-public-modules*", "lease": "shared-module-catalog" },
    { "pattern": "supabase/migrations/**", "lease": "supabase-mutate" },
    { "pattern": "supabase/seed/**", "lease": "supabase-mutate" }
  ],
  "blockedPaths": [
    ".env",
    ".env.*",
    "local-data",
    "local-data/**",
    ".next",
    ".next/**",
    "playwright-report",
    "playwright-report/**",
    "test-results",
    "test-results/**",
    "public/ecmo-teaching-preview",
    "public/ecmo-teaching-preview/**",
    "IP_PubMed/nbib files",
    "IP_PubMed/nbib files/**",
    "Critical_Care_Reference/Device Manuals",
    "Critical_Care_Reference/Device Manuals/**",
    "Critical_Care_Reference/Full_textbooks",
    "Critical_Care_Reference/Full_textbooks/**",
    "Critical_Care_Reference/Summary files",
    "Critical_Care_Reference/Summary files/**",
    "Preference_card_module/AccessGUDID_Delimited_Full_Release_*",
    "Preference_card_module/AccessGUDID_Delimited_Full_Release_*/**",
    "Preference_card_module/UCSD",
    "Preference_card_module/UCSD/**",
    "Preference_card_module/Catalogs and IFU for confirmation/**/*.pdf"
  ],
  "inputProfiles": {
    "none": [],
    "environment": ["environment"],
    "critical-care": [
      "environment",
      "criticalCareManuals",
      "criticalCareTextbooks",
      "criticalCareSummaries"
    ],
    "literature": ["environment", "literatureNbib"],
    "preference-cards": [
      "environment",
      "gudid",
      "preferenceCardManuals",
      "preferenceCardConfirmation"
    ],
    "raw-3d": ["environment", "raw3dAssets"],
    "critical-care-3d": [
      "environment",
      "criticalCareManuals",
      "criticalCareTextbooks",
      "criticalCareSummaries",
      "raw3dAssets"
    ]
  },
