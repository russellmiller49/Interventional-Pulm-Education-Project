    "environment": ".env.local",
    "literatureNbib": "IP_PubMed/nbib files",
    "criticalCareManuals": "Critical_Care_Reference/Device Manuals",
    "criticalCareTextbooks": "Critical_Care_Reference/Full_textbooks",
