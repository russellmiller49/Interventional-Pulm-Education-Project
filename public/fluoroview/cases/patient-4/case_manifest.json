  "lessons": [
    {
      "id": "projection-basics",
      "title": "CT-to-fluoroscopy projection basics",
      "objective": "Compare a CT slice with a projection image and identify overlapping structures.",
      "task": "Sweep from AP to RAO/LAO and watch ribs, spine, and airway labels overlap."
    },
    {
      "id": "angle-separation",
      "title": "RAO/LAO target separation",
      "objective": "Recognize that changing C-arm angle can separate an airway target from dense anatomy.",
      "task": "Use the nearest-frame indicator while moving the RAO/LAO slider."
    },
    {
      "id": "collimation-dose",
      "title": "Collimation and relative KAP",
      "objective": "Relate field size to educational relative KAP/DAP.",
      "task": "Reduce collimation and compare dose rate with relative KAP."
    },
    {
      "id": "abc-surprise",
      "title": "ABC/AERC surprise",
      "objective": "See that brightness can remain stable while relative exposure rises.",
      "task": "Enable ABC and move to a thicker oblique projection."
    }
  ],
