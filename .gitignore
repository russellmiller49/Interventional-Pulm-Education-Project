# Local authoring inputs and generated artifacts
#
# These files are not read by the production application. Keep the source
# scripts, manifests, and small metadata in Git, while storing the heavyweight
# media/model inputs locally or in the project's external asset storage.
/.deploy_push/
/storybook-static/
/artifacts/
/tmp-*.bin

# Podcast source media. Production playback uses the private Supabase bucket;
# transcripts and application metadata remain tracked.
/podcasts/**/*.mp3
/podcasts/**/*.pdf
/Imports/Journal_Club_Podcasts/**/*.mp3

