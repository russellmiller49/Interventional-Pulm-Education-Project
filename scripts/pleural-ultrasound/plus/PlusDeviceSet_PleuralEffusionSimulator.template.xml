<?xml version="1.0" encoding="utf-8"?>
<PlusConfiguration version="2.3">
  <DataCollection StartupDelaySec="1.0">
    <DeviceSet
      Name="Pleural effusion ultrasound simulator"
      Description="Offline PLUS Toolkit frame-generation template for the browser pleural ultrasound simulator." />

    <Device
      Id="TrackerDevice"
      Type="OpenIGTLinkTracker"
      MessageType="TDATA"
      ServerAddress="127.0.0.1"
      ServerPort="18946"
      IgtlMessageCrcCheckEnabled="false"
      UseReceivedTimestamps="false"
      UseLastTransformsOnReceiveTimeout="true"
      ToolReferenceFrame="Tracker">
      <DataSources>
        <DataSource Type="Tool" Id="Probe" />
        <DataSource Type="Tool" Id="Reference" />
      </DataSources>
      <OutputChannels>
        <OutputChannel Id="TrackerStream">
          <DataSource Id="Probe" />
          <DataSource Id="Reference" />
        </OutputChannel>
      </OutputChannels>
    </Device>

    <Device
      Id="VideoDevice"
      Type="UsSimulator"
      LocalTimeOffsetSec="0.0"
      AcquisitionRate="15">
      <DataSources>
        <DataSource Type="Video" Id="Video" PortUsImageOrientation="MF" />
      </DataSources>
      <InputChannels>
        <InputChannel Id="TrackerStream" />
      </InputChannels>
      <OutputChannels>
        <OutputChannel Id="VideoStream" VideoDataSourceId="Video" />
      </OutputChannels>

      <vtkPlusUsSimulatorAlgo
        ImageCoordinateFrame="Image"
        ReferenceCoordinateFrame="Reference"
        IncomingIntensityMwPerCm2="300"
        BrightnessConversionGamma="0.22"
        BrighntessConversionOffset="28"
        NumberOfScanlines="96"
        NumberOfSamplesPerScanline="720"
        NoiseAmplitude="5.0"
        NoiseFrequency="2.5 3.5 1"
        NoisePhase="50 20 0">
        <SpatialModel
          Name="Air"
          DensityKgPerM3="1.2"
          SoundVelocityMPerSec="343"
          AttenuationCoefficientDbPerCmMhz="100.0"
          BackscatterDiffuseReflectionCoefficient="0.0"
          SurfaceReflectionIntensityDecayDbPerMm="50" />
        <SpatialModel
          Name="Skin"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/skin.stl"
          DensityKgPerM3="1100"
          SoundVelocityMPerSec="1540"
          AttenuationCoefficientDbPerCmMhz="0.7"
          BackscatterDiffuseReflectionCoefficient="0.04"
          SurfaceSpecularReflectionCoefficient="0.04"
          SurfaceDiffuseReflectionCoefficient="0.04"
          TransducerSpatialModelMaxOverlapMm="35" />
        <SpatialModel
          Name="Muscle"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/muscle.stl"
          DensityKgPerM3="1060"
          SoundVelocityMPerSec="1580"
          AttenuationCoefficientDbPerCmMhz="1.1"
          BackscatterDiffuseReflectionCoefficient="0.06"
          SurfaceSpecularReflectionCoefficient="0.06"
          SurfaceDiffuseReflectionCoefficient="0.06"
          TransducerSpatialModelMaxOverlapMm="35" />
        <SpatialModel
          Name="Rib"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/rib.stl"
          DensityKgPerM3="1900"
          SoundVelocityMPerSec="3000"
          AttenuationCoefficientDbPerCmMhz="12.0"
          BackscatterDiffuseReflectionCoefficient="0.2"
          SurfaceSpecularReflectionCoefficient="0.7"
          SurfaceDiffuseReflectionCoefficient="0.25"
          SurfaceReflectionIntensityDecayDbPerMm="5"
          TransducerSpatialModelMaxOverlapMm="35" />
        <SpatialModel
          Name="Lung"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/lung.stl"
          DensityKgPerM3="450"
          SoundVelocityMPerSec="650"
          AttenuationCoefficientDbPerCmMhz="6.0"
          BackscatterDiffuseReflectionCoefficient="0.18"
          SurfaceSpecularReflectionCoefficient="0.5"
          SurfaceDiffuseReflectionCoefficient="0.2" />
        <SpatialModel
          Name="PleuralFluid"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/right-pleural-effusion.stl"
          DensityKgPerM3="1000"
          SoundVelocityMPerSec="1480"
          AttenuationCoefficientDbPerCmMhz="0.01"
          BackscatterDiffuseReflectionCoefficient="0.0"
          SurfaceSpecularReflectionCoefficient="0.02"
          SurfaceDiffuseReflectionCoefficient="0.0" />
        <SpatialModel
          Name="Diaphragm"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/diaphragm.stl"
          DensityKgPerM3="1060"
          SoundVelocityMPerSec="1580"
          AttenuationCoefficientDbPerCmMhz="1.3"
          BackscatterDiffuseReflectionCoefficient="0.12"
          SurfaceSpecularReflectionCoefficient="0.45"
          SurfaceDiffuseReflectionCoefficient="0.12" />
        <SpatialModel
          Name="Liver"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/liver.stl"
          DensityKgPerM3="1060"
          SoundVelocityMPerSec="1550"
          AttenuationCoefficientDbPerCmMhz="0.55"
          BackscatterDiffuseReflectionCoefficient="0.12"
          SurfaceSpecularReflectionCoefficient="0.08"
          SurfaceDiffuseReflectionCoefficient="0.08" />
        <SpatialModel
          Name="Spleen"
          ObjectCoordinateFrame="Reference"
          ModelFile="ModelsLowRes/spleen.stl"
          DensityKgPerM3="1060"
          SoundVelocityMPerSec="1550"
          AttenuationCoefficientDbPerCmMhz="0.55"
          BackscatterDiffuseReflectionCoefficient="0.12"
          SurfaceSpecularReflectionCoefficient="0.08"
          SurfaceDiffuseReflectionCoefficient="0.08" />

        <RfProcessing>
          <ScanConversion
            TransducerName="PleuralCurvilinear"
            TransducerGeometry="CURVILINEAR"
            RadiusStartMm="5.0"
            RadiusStopMm="120.0"
            ThetaStartDeg="-35.0"
            ThetaStopDeg="35.0"
            TransducerCenterPixel="320 0"
            OutputImageSizePixel="640 480"
            OutputImageSpacingMmPerPixel="0.16 0.16" />
        </RfProcessing>
      </vtkPlusUsSimulatorAlgo>
    </Device>

    <Device
      Id="TrackedVideoDevice"
      Type="VirtualMixer">
      <InputChannels>
        <InputChannel Id="TrackerStream" />
        <InputChannel Id="VideoStream" />
      </InputChannels>
      <OutputChannels>
        <OutputChannel Id="TrackedVideoStream" />
      </OutputChannels>
    </Device>
  </DataCollection>

  <PlusOpenIGTLinkServer
    MaxNumberOfIgtlMessagesToSend="10"
    MaxTimeSpentWithProcessingMs="50"
    ListeningPort="18944"
    SendValidTransformsOnly="true"
    OutputChannelId="TrackedVideoStream">
    <DefaultClientInfo>
      <MessageTypes>
        <Message Type="IMAGE" />
        <Message Type="TRANSFORM" />
      </MessageTypes>
      <ImageNames>
        <Image Name="Image" EmbeddedTransformToFrame="Reference" />
      </ImageNames>
      <TransformNames>
        <Transform Name="ProbeToReference" />
      </TransformNames>
    </DefaultClientInfo>
  </PlusOpenIGTLinkServer>

  <CoordinateDefinitions>
    <Transform
      From="Image"
      To="Probe"
      Matrix="
        0 -0.16 0 0
        0 0 0.16 0
        0.16 0 0 -51.2
        0 0 0 1" />
    <Transform
      From="Image"
      To="TransducerOriginPixel"
      Matrix="
        1 0 0 -320
        0 1 0 5
        0 0 1 0
        0 0 0 1" />
  </CoordinateDefinitions>
</PlusConfiguration>
